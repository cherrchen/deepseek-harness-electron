  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "electron-builder --publish never",
    "start": "pnpm run build && electron .",
    "test": "vitest run --root ../.. apps/electron/tests/runtime.spec.ts"
