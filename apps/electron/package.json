    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": false,
    "artifactName": "DeepSeek-Harness-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/LICENSE.lobe-icons",
        "to": "LICENSE.lobe-icons"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "executableName": "deepseek-harness",
      "icon": "build/icons",
      "maintainer": "cherrchen <cherrchen@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
