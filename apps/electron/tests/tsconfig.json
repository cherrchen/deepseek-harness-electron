{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "rootDir": "../../..",
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../scripts/*.mjs"
  ]
}
