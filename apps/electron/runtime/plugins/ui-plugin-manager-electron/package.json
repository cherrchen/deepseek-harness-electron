{
  "name": "@dsh-electron/dsh-electron-ui-plugin-manager",
  "description": "Installed plugin lifecycle management for Electron Desktop Settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@dsh-electron/dsh-electron-desktop-capabilities"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "package.json"
  ]
}
