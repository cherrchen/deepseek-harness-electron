# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# If a file class ever genuinely needs CRLF in the working tree (.bat/.cmd
# for cmd.exe), add a `*.bat text eol=crlf` override AFTER this line — the
# in-repo form stays LF; CRLF becomes checkout-time presentation only.
* text=auto eol=lf

*.pdf binary

# The repository landing pages are maintained by the desktop fork. Keep them
# when the scheduled workflow merges the upstream repository.
README.md merge=ours
README.zh.md merge=ours

# Upstream-owned agent instructions. Accept upstream changes during sync and
# restore @AGENTS.downstream.md afterward.
AGENTS.md merge=theirs

# Upstream owns the harness workflows and their shared specification. The
# desktop fork owns only its prefixed workflows, sync workflow, and focused spec.
.github/workflows/*.yml merge=theirs
.github/workflows/desktop-*.yml merge=ours
.github/workflows/sync-upstream.yml merge=ours
scripts/ci-workflow.spec.ts merge=theirs
scripts/desktop-workflow.spec.ts merge=ours

# Pairing records are generated from the three confirmed owner-blob pairs.
# The worktree-local installer registers the fail-closed driver command.
*.i18n.yaml merge=dsh-translation-pairing

# Override the pairing driver for the repository landing-page record.
README.i18n.yaml merge=ours
